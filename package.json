{
  "name": "pcf-yard-pulse",
  "version": "1.0.0",
  "description": "Yard Pulse: a Power Apps (PCF) dataset control that renders yard slots as a live heatmap.",
  "scripts": {
    "build": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "lint": "eslint YardPulse demo test",
    "lint:fix": "pcf-scripts lint fix",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "node scripts/build-demo.mjs && npx --yes http-server@14.1.1 site -p 5173 -c-1",
    "demo:build": "node scripts/build-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@microsoft/eslint-plugin-power-apps": "^0.2.51",
    "@types/node": "^18.19.86",
    "@types/powerapps-component-framework": "^1.3.16",
    "esbuild": "^0.25.12",
    "eslint-plugin-promise": "^7.1.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.44.0",
    "vitest": "^3.2.7"
  },
  "private": true,
  "license": "MIT"
}
